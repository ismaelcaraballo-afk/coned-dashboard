# ── API Keys ──
# LLM fallback chain: Claude → Groq → OpenRouter
# Uncomment your preferred provider(s)
# ANTHROPIC_API_KEY=sk-ant-...
GROQ_API_KEY=gsk_...
OPENROUTER_API_KEY=sk-or-v1-...

# ── Weather Data ──
# Optional: Get a free NOAA NCEI CDO API token at https://www.ncdc.noaa.gov/cdo-web/token
# If not set, the NOAA degree-days pipeline uses hardcoded Central Park historical data
# NOAA_TOKEN=YOUR_TOKEN_HERE

# ── Dashboard ──
DASHBOARD_PASSWORD=your-password-here

# ── Postgres (M6 status events + watchlist) ──
# Local dev matches docker-compose.yml. Postgres is optional in dev per D12
# (initSchema logs and continues if the DB is unreachable). Required in production.
DATABASE_URL=postgresql://coned:coned@localhost:5432/coned_dashboard
# HMAC secret used to pseudonymize the actor token written to status events.
# Fail-fast in production; dev falls back to a dev-only string if unset.
ACTOR_HMAC_SECRET=dev-only-hmac-secret-change-me
# Optional: base64-encoded CA bundle for full TLS verification against managed Postgres (Railway).
# DATABASE_CA_CERT=

# ── Development Flags ──
# Set to "true" to skip proactive alert enrichment at startup (preserves rate budget for testing)
# SKIP_ENRICHMENT=true